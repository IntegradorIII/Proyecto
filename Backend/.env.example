# ========================================================
# Variables de Entorno del Backend - Ejemplo de Configuración
# ========================================================

# Puerto en el que se ejecutará el servidor Express
PORT=3000

# URL de conexión a la base de datos PostgreSQL (local o Render)
# Formato: postgresql://<usuario>:<password>@<host>/<database>?ssl=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asistencia_db

# URL base pública o local de la API
APP_URL=http://localhost:3000

# Clave secreta para la firma y verificación de tokens JWT
JWT_SECRET=tu_clave_secreta_aqui
